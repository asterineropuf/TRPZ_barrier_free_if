<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-white fw-semibold py-3">
        <i class="bi bi-person-gear text-primary me-1"></i> Налаштування профілю (<%= resource.email %>)
      </div>
      <div class="card-body p-4">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :email, "Електронна пошта", class: "form-label fw-semibold" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, "Новий пароль", class: "form-label fw-semibold" %>
            <span class="text-muted small">(залиште порожнім, якщо не змінюєте)</span>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, "Підтвердження нового пароля", class: "form-label fw-semibold" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :current_password, "Поточний пароль", class: "form-label fw-semibold" %>
            <span class="text-muted small">(потрібен для підтвердження змін)</span>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
          </div>

          <div class="d-flex gap-2">
            <%= f.submit "Оновити дані", class: "btn btn-primary" %>
            <%= link_to "Назад", root_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card border-danger-subtle shadow-sm">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <strong class="text-danger">Видалення акаунта</strong>
          <div class="small text-muted">Додані вами локації залишаться в реєстрі міста.</div>
        </div>
        <%= button_to "Видалити акаунт", registration_path(resource_name), data: { turbo_confirm: "Ви впевнені?" }, method: :delete, class: "btn btn-outline-danger btn-sm" %>
      </div>
    </div>
  </div>
</div>